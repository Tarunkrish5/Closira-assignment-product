# Copy to .env and edit. All values have sensible defaults so this file is
# optional for local development.

APP_NAME=Closira Enquiry API
APP_VERSION=1.0.0
ENVIRONMENT=development

# SQLite (default) — perfect for local evaluation.
DATABASE_URL=sqlite:///./closira.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/closira

DEFAULT_TENANT_ID=tenant_demo

LOG_LEVEL=INFO
LOG_JSON=true

# Optionally simulate a slow worker so the async behaviour is observable.
SOP_MATCH_ARTIFICIAL_DELAY_MS=0
